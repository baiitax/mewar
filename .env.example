# Copy to .env.local and set strong, unique values. Never commit .env.local.
# SQLite path is relative to prisma/schema.prisma (creates prisma/dev.db).
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_TRUST_HOST="true"

# Optional dev bootstrap only — run `npm run db:seed` after setting a long random password.
MIU_BOOTSTRAP_ADMIN_EMAIL="admin@miu.local"
MIU_BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-random-password-at-least-16-characters"

# Development preview label only; it does not mean an official intake is open.
MIU_PREVIEW_APPLICATION_SESSION="2026/27"

# Production applicant portal gates. Do not set these until the named integration/approval is actually complete.
# MIU_APPLICATIONS_ENABLED="true"
# MIU_ACTIVE_APPLICATION_SESSION="2026/27"
# MIU_EMAIL_OTP_READY="true"
# MIU_SMS_OTP_READY="true"
# MIU_DOCUMENT_STORAGE_READY="true"
# MIU_ANTIVIRUS_SCAN_READY="true"
# MIU_PRIVACY_NOTICE_APPROVED="true"
# APP_PII_ENCRYPTION_KEY="managed-secret-vault-value"
# APP_PII_DEDUP_KEY="different-managed-secret-vault-value"

# Optional only after ICT supplies the institution-approved OIDC configuration:
# MIU_IDP_ISSUER="https://identity.example.edu.ng"
# MIU_IDP_CLIENT_ID=""
# MIU_IDP_CLIENT_SECRET=""
