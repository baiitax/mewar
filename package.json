{
  "name": "miu-nigeria-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --host 0.0.0.0",
    "test:smoke": "node scripts/smoke-foundation.mjs",
    "test:fees": "node scripts/test-fee-workflow.cjs",
    "test:applicants": "node scripts/test-applicant-portal.cjs",
    "test:students": "node scripts/test-phase4-students.cjs",
    "test:finance": "node scripts/test-phase5-finance.cjs",
    "test:governance": "node scripts/test-governance-register.cjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^18.0.8",
    "postcss": "^8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
